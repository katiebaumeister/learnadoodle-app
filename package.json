{
  "name": "hi-world-app",
  "version": "1.0.0",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "test:openai": "expo start --web --port 19006",
    "web:no-404": "node scripts/dev-server-web.js",
    "seed:chatbot-knowledge": "node scripts/seed-chatbot-knowledge.js",
    "test:assistant": "node --test lib/assistant/intentTriage.test.js lib/assistant/chatParsers.test.js lib/assistant/materialParse.test.js",
    "build": "node scripts/write-env-for-build.cjs && npx expo export --platform web && node scripts/generate-favicon.cjs && node scripts/patch-favicon-cache-bust.cjs && node scripts/patch-og-meta.cjs && node scripts/patch-landing-hero-preload.cjs && node scripts/patch-auth-redirect.cjs && cp public/sw-uuid-intercept.js dist/ 2>/dev/null || true",
    "vercel-build": "node scripts/write-env-for-build.cjs && npx expo export --platform web && node scripts/generate-favicon.cjs && node scripts/patch-favicon-cache-bust.cjs && node scripts/patch-og-meta.cjs && node scripts/patch-landing-hero-preload.cjs && node scripts/patch-auth-redirect.cjs && cp public/sw-uuid-intercept.js dist/ 2>/dev/null || true"
  },
  "dependencies": {
    "@expo/metro-config": "~54.0.0",
    "@expo/metro-runtime": "~6.1.2",
    "@expo/vector-icons": "^15.0.3",
    "@hello-pangea/dnd": "^18.0.1",
    "@lottiefiles/dotlottie-react": "^0.13.5",
    "@react-navigation/native": "^7.1.14",
    "@react-navigation/stack": "^7.4.2",
    "@supabase/supabase-js": "^2.93.3",
    "cors": "^2.8.6",
    "date-fns": "^4.1.0",
    "dotenv": "^17.2.3",
    "expo": "~54.0.0",
    "expo-font": "~14.0.0",
    "expo-status-bar": "~3.0.9",
    "express": "^5.2.1",
    "lottie-react-native": "^7.3.5",
    "lucide-react": "^0.523.0",
    "react": "19.1.0",
    "react-datepicker": "^8.4.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-calendars": "^1.1313.0",
    "react-native-dotenv": "^3.4.11",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-vector-icons": "^10.3.0",
    "react-native-web": "^0.21.0"
  },
  "devDependencies": {
    "@babel/core": "^7.20.0",
    "@types/react": "~19.1.0",
    "@types/react-native": "^0.73.0",
    "sharp": "^0.34.5",
    "to-ico": "^1.1.5",
    "typescript": "~5.9.2"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "private": true
}
